# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# PADDLE ZAHLUNGSABWICKLUNG (Merchant of Record)
# ==============================================================================
# Paddle API-Schlüssel (Developer Tools -> Authentication -> API Keys)
PADDLE_API_KEY=

# Paddle Client Token (für Frontend-Checkout)
PADDLE_CLIENT_TOKEN=

# Paddle Umgebung: "production" (Live-Betrieb) oder "sandbox" (Test-Modus)
PADDLE_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# PADDLE PREIS-CODES (Price IDs beginnend mit 'pri_...')
# ------------------------------------------------------------------------------
# 1. Gesetzes-Scanner Hauptbereich
PADDLE_PRICE_GESETZE_YEARLY=
PADDLE_PRICE_GESETZE_LIFETIME=

# 2. StVO Verkehrsmittel-Scanner
PADDLE_PRICE_TRAFFIC_YEARLY=
PADDLE_PRICE_TRAFFIC_LIFETIME=

# 3. Schriftsatz-Module (4 separate Codes für jedes Rechtsmittel):
PADDLE_PRICE_SCHRIFTSATZ_BERUFUNG=
PADDLE_PRICE_SCHRIFTSATZ_REVISION=
PADDLE_PRICE_SCHRIFTSATZ_WIEDERAUFNAHME=
PADDLE_PRICE_SCHRIFTSATZ_VERFASSUNGSBESCHWERDE=

# ==============================================================================
# OPTIONAL: STRIPE (Fallback falls alternativ genutzt)
# ==============================================================================
STRIPE_SECRET_KEY=
STRIPE_PRICE_GESETZE_YEARLY=
STRIPE_PRICE_GESETZE_LIFETIME=
STRIPE_PRICE_TRAFFIC_YEARLY=
STRIPE_PRICE_TRAFFIC_LIFETIME=
STRIPE_PRICE_SCHRIFTSATZ_BERUFUNG=
STRIPE_PRICE_SCHRIFTSATZ_REVISION=
STRIPE_PRICE_SCHRIFTSATZ_WIEDERAUFNAHME=
STRIPE_PRICE_SCHRIFTSATZ_VERFASSUNGSBESCHWERDE=

